        local card = {}
        local bg = ui.box(k.root, x, 520, 410, 560, ui.C_BG, "panel_rounded")
        card.title = ui.text(bg, 0, 230, "", 0.52, ui.C_WHITE)
        card.desc = ui.para(bg, -180, 180, "", 0.36, ui.C_DIM, 360)
        card.lock = ui.box(bg, 0, -110, 64, 64, ui.C_DIM, "padlock")
        local preset = campaign_db.SKIRMISH[i]
        _, card.btn, card.lbl = ui.button(self.druid, bg, 0, -220, 340, 84, "", ui.C_GREEN, "panel_rounded", function()
