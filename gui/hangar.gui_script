    self.skirm = k
end

local function build_hangar(self)
    local g = {}
    g.root = ui.box(self.root, 0, 0, 0, 0, vmath.vector4(0, 0, 0, 0))
    -- Ship list
    g.ships = {}
    for i, sid in ipairs(ships_db.PLAYER_SHIPS) do
        local y = 880 - (i - 1) * 112
        local card = {}
        local _, n = ui.button(self.druid, g.root, 245, y, 420, 100, "", ui.C_CARD, "panel_rounded", function()
            self.view_ship = sid
            self.preview_cosmetic = nil
            refresh(self)
        end, 0.1)
        card.node = n
        card.name = ui.text(n, -185, 16, "", 0.46, ui.C_WHITE, gui.PIVOT_W)
        card.role = ui.text(n, -185, -22, "", 0.3, ui.C_DIM, gui.PIVOT_W)
        card.status = ui.text(n, 190, 0, "", 0.36, ui.C_GREEN, gui.PIVOT_E)
        card.lock = ui.box(n, 20, 0, 34, 34, ui.C_DIM, "padlock")
        g.ships[i] = card
    end
    -- Centre: title, stats, action
    g.ship_title = ui.text(g.root, 840, 900, "", 0.7, ui.C_WHITE)
    g.ship_role = ui.text(g.root, 840, 850, "", 0.36, ui.C_DIM)
    local sp = ui.box(g.root, 840, 260, 700, 100, ui.C_BG, "panel_rounded")
    g.stat_cells = {}
    for i = 1, 4 do
        local cx = -262 + (i - 1) * 175
        g.stat_cells[i] = {
            title = ui.text(sp, cx, 24, "", 0.32, ui.C_DIM),
            val = ui.text(sp, cx, -12, "", 0.56, ui.C_WHITE),
        }
    end
    _, g.btn_action, g.lbl_action = ui.button(self.druid, g.root, 840, 140, 440, 90, "", ui.C_GREEN, "panel_rounded", function()
        local sid = self.view_ship
        local st, price = progress.ship_status(sid)
        if st == "owned" then
            progress.select_ship(sid)
        elseif st == "buy" then
            if progress.buy_ship(sid) then
                audio.play("levelup", 0.6)
                toast(self, fmt("ship_bought", i18n.t("ship_" .. sid)), ui.C_GREEN)
            else
                audio.play("error", 0.4)
                toast(self, fmt("need_credits", price), ui.C_CORAL)
            end
        else
            audio.play("error", 0.4)
        end
        refresh(self)
    end, 0.5)
    _, g.btn_test, g.lbl_test = ui.button(self.druid, g.root, 840, 55, 440, 60, "", ui.C_AMBER, "panel_rounded", function()
        local s = progress.get()
        if not s.test_drive_active then
            poki.rewarded_break(function(ok)
                if ok then
                    s.test_drive_active = true
                    refresh(self)
                end
            end)
        end
    end, 0.36)

    -- Right panel with tabs
    local rp = ui.box(g.root, 1550, 520, 680, 820, ui.C_BG, "panel_rounded")
    g.tabs = {}
    for i = 1, 3 do
        local tab = i
        local _, n, l = ui.button(self.druid, rp, -225 + (i - 1) * 225, 365, 215, 62, "", ui.C_ELEV, "panel_rounded", function()
            self.hg_tab = tab
            refresh(self)
        end, 0.38)
        g.tabs[i] = { node = n, lbl = l }
    end
    -- Upgrades pane
    g.pane_upg = ui.box(rp, 0, 0, 0, 0, vmath.vector4(0, 0, 0, 0))
    g.upg = {}
    for i, key in ipairs(UPGRADE_KEYS) do
        local y = 250 - (i - 1) * 140
        local row = ui.box(g.pane_upg, 0, y, 630, 124, ui.C_CARD, "panel_rounded")
        local r = {}
        r.name = ui.text(row, -295, 30, "", 0.44, ui.C_WHITE, gui.PIVOT_W)
        r.delta = ui.text(row, -295, -36, "", 0.32, ui.C_GREEN, gui.PIVOT_W)
        ui.box(row, -130, -2, 330, 14, ui.C_BG)
        r.fill = ui.box(row, -295, -2, 330, 14, ui.C_AQUA)
        gui.set_pivot(r.fill, gui.PIVOT_W)
        local node_key = key
        _, r.btn, r.lbl = ui.button(self.druid, row, 215, 0, 180, 84, "", ui.C_GREEN, "panel_rounded", function()
            local sid = self.view_ship
            if progress.upgrade_node(sid, node_key) then
                audio.play("coin", 0.7)
            else
                audio.play("error", 0.35)
            end
            refresh(self)
        end, 0.36)
        g.upg[key] = r
    end
    -- Modules pane
    g.pane_mod = ui.box(rp, 0, 0, 0, 0, vmath.vector4(0, 0, 0, 0))
    g.mod_hint = ui.para(g.pane_mod, -300, 315, "", 0.3, ui.C_DIM, 600)
    g.mods = {}
    for i = 1, 3 do
        local y = 175 - (i - 1) * 205
        local card = {}
        card.node = ui.box(g.pane_mod, 0, y, 630, 190, ui.C_CARD, "panel_rounded")
        card.name = ui.text(card.node, -295, 66, "", 0.46, ui.C_WHITE, gui.PIVOT_W)
        card.cd = ui.text(card.node, 120, 66, "", 0.3, ui.C_DIM, gui.PIVOT_E)
        card.desc = ui.para(card.node, -295, 40, "", 0.3, ui.C_DIM, 430)
        card.lock = ui.text(card.node, 220, 0, "", 0.34, ui.C_CORAL)
        local idx = i
        local function assign(slot)
            local def = ships_db.get(self.view_ship)
            if progress.set_loadout(self.view_ship, slot, def.modules[idx]) then
                audio.play("ui_click", 0.6)
            else
                audio.play("error", 0.4)
            end
            refresh(self)
        end
        _, card.b1 = ui.button(self.druid, card.node, 220, 36, 140, 58, "M1", ui.C_BG, "panel_rounded", function() assign(1) end, 0.4)
        _, card.b2 = ui.button(self.druid, card.node, 220, -36, 140, 58, "M2", ui.C_BG, "panel_rounded", function() assign(2) end, 0.4)
        g.mods[i] = card
    end
    -- Style pane
    g.pane_style = ui.box(rp, 0, 0, 0, 0, vmath.vector4(0, 0, 0, 0))
    g.skins_hdr = ui.text(g.pane_style, -300, 300, "", 0.42, ui.C_AQUA, gui.PIVOT_W)
    g.skins = {}
    for i = 1, 24 do
        local col, row = (i - 1) % 8, math.floor((i - 1) / 8)
        local border = ui.box(g.pane_style, -266 + col * 76, 245 - row * 66, 66, 58, ui.C_BG, "panel_rounded")
        local fill = ui.box(border, 0, 0, 54, 46, ui.C_WHITE, "panel_rounded")
        local id = i
        self.druid:new_button(border, function()
            local s = progress.get()
            audio.play("ui_click", 0.5)
            if s.unlocked_skins[id] then
                self.preview_cosmetic = nil
                s.equipped_skin = id
                progress.save()
            else
                self.preview_cosmetic = { kind = "skin", id = id }
            end
            refresh(self)
        end)
        g.skins[i] = { border = border, fill = fill }
    end
    g.trails_hdr = ui.text(g.pane_style, -300, 40, "", 0.42, ui.C_AQUA, gui.PIVOT_W)
    g.trails = {}
    for i = 1, 12 do
        local col, row = (i - 1) % 6, math.floor((i - 1) / 6)
        local border = ui.box(g.pane_style, -250 + col * 100, -15 - row * 66, 88, 58, ui.C_BG, "panel_rounded")
        local fill = ui.box(border, 0, 0, 76, 46, ui.C_WHITE, "panel_rounded")
        local id = i
        self.druid:new_button(border, function()
            local s = progress.get()
            audio.play("ui_click", 0.5)
            if s.unlocked_trails[id] then
                self.preview_cosmetic = nil
                s.equipped_trail = id
                progress.save()
            else
                self.preview_cosmetic = { kind = "trail", id = id }
            end
            refresh(self)
        end)
        g.trails[i] = { border = border, fill = fill }
    end
    _, g.btn_craft_rand, g.lbl_craft_rand = ui.button(self.druid, g.pane_style, -160, -205, 300, 72, "", ui.C_AQUA, "panel_rounded", function()
        if progress.craft_random_cosmetic() then
            self.preview_cosmetic = nil
            audio.play("heal", 0.6)
        else
            audio.play("error", 0.4)
        end
        refresh(self)
    end, 0.34)
    _, g.btn_craft_sel, g.lbl_craft_sel = ui.button(self.druid, g.pane_style, 160, -205, 300, 72, "", ui.C_ELEV, "panel_rounded", function()
        local pk = self.preview_cosmetic
        if pk and progress.craft_cosmetic(pk.kind, pk.id) then
            self.preview_cosmetic = nil
            audio.play("heal", 0.6)
        else
            audio.play("error", 0.4)
        end
        refresh(self)
    end, 0.34)
    _, _, g.lbl_rand_ad = ui.button(self.druid, g.pane_style, 0, -300, 620, 70, "", ui.C_CORAL, "panel_rounded", function()
        poki.rewarded_break(function(ok)
            if ok then
                self.preview_cosmetic = nil
                progress.unlock_random_cosmetic()
                audio.play("heal", 0.6)
                refresh(self)
            end
        end)
    end, 0.4)
    _, _, g.lbl_back = ui.button(self.druid, g.root, 180, 75, 280, 80, "", ui.C_ELEV, "panel_rounded", function() go_screen(self, "hub") end, 0.5)
    self.hg = g
end

local function build_settings(self)
    local t = {}
    t.root = ui.box(self.root, 960, 540, 1920, 1080, vmath.vector4(0.02, 0.04, 0.08, 0.75))
    t.blocker = self.druid:new_blocker(t.root)
    local p = ui.box(t.root, -280, 0, 560, 660, ui.C_BG, "panel_rounded")
    t.title = ui.text(p, 0, 280, "", 0.72, ui.C_AQUA)
    local function opt(y, fn)
        local _, _, l = ui.button(self.druid, p, 0, y, 460, 64, "", ui.C_ELEV, "panel_rounded", function()
            fn()
            progress.save()
            refresh(self)
        end, 0.4)
        return l
    end
    t.lbl_sound = opt(190, function()
        local s = progress.settings()
        s.muted = not s.muted
        audio.set_muted(s.muted)
    end)
    t.lbl_af = opt(115, function()
        local s = progress.settings()
        s.autofire = not s.autofire
    end)
    t.lbl_sens = opt(40, function()
        local s = progress.settings()
        local steps = { 0.6, 0.8, 1.0, 1.25, 1.5 }
        local idx = 3
        for i, v in ipairs(steps) do if math.abs(v - (s.sensitivity or 1)) < 0.01 then idx = i end end
        s.sensitivity = steps[(idx % #steps) + 1]
    end)
    t.lbl_inv = opt(-35, function()
        local s = progress.settings()
        s.invert_y = not s.invert_y
    end)
    t.lbl_lang = opt(-110, function()
        progress.settings().language = i18n.cycle_language()
    end)
    _, _, t.lbl_close = ui.button(self.druid, p, 0, -250, 460, 76, "", ui.C_GREEN, "panel_rounded", function()
        self.settings_open = false
        refresh(self)
    end, 0.5)
    local cpanel = ui.box(t.root, 330, 0, 600, 660, ui.C_BG, "panel_rounded")
    t.ctl_title = ui.text(cpanel, 0, 280, "", 0.56, ui.C_GOLD)
    t.ctl = ui.para(cpanel, -265, 235, "", 0.32, ui.C_WHITE, 530)
    self.set = t
end

local function build(self)
    if self.root then gui.delete_node(self.root) end
    if self.druid then self.druid:final() end
    self.druid = druid.new(self)
    self.root = ui.box(nil, 0, 0, 0, 0, vmath.vector4(0, 0, 0, 0))
    build_topbar(self)
    build_hub(self)
    build_campaign(self)
    build_skirmish(self)
    build_hangar(self)
    build_settings(self)
    gui.set_enabled(self.root, self.visible)
end

-- =================================================================== LIFECYCLE
function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible = false
    self.screen = "hub"
    self.hg_tab = 1
    self.sel_sector = 1
    self.sel_mission = "s1m1"
    self.settings_open = false
    self.toast_timer = 0
    build(self)
end

function final(self)
    if self.druid then self.druid:final() end
end

function update(self, dt)
    if self.druid then self.druid:update(dt) end
    if self.toast_timer > 0 then
        self.toast_timer = self.toast_timer - dt
        if self.toast_timer <= 0 then gui.set_enabled(self.toast_bg, false) end
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if action_id == hash("pause") and action.pressed then
        if self.settings_open then
            self.settings_open = false
            refresh(self)
        elseif self.screen ~= "hub" then
            go_screen(self, "hub")
        end
        return true
    end
    if self.druid then return self.druid:on_input(action_id, action) end
    return false
end

function on_message(self, message_id, message)
    if message_id == hash("set_visible") then
        self.visible = message.visible and true or false
        gui.set_enabled(self.root, self.visible)
        if self.visible then
            self.settings_open = false
            go_screen(self, "hub")
            local n = progress.claimable_contracts()
            if n > 0 then toast(self, fmt("contracts_ready", n), ui.C_GREEN) end
        end
    end
end
