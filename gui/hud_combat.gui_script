        self.druid, self.pause_panel, 0, -125, 380, 74, i18n.t("quit_hangar"), ui.C_CORAL, "panel_rounded",
        function()
            reset_input()
            gui.set_enabled(self.pause_backdrop, false)
            if self.blocker_pause then self.blocker_pause:set_enabled(false) end
            msg.post("/controller#main", "open_hangar")
        end, 0.56
    )
    gui.set_enabled(self.pause_backdrop, false)

    -- Post-Match Results Overlay
    self.result_panel = ui.box(self.root, 960, 540, 720, 500, ui.C_BG, "panel_rounded")
    self.txt_res_title = ui.text(self.result_panel, 0, 185, "VICTORY", 1.15, ui.C_GOLD)
    self.txt_res_stats = ui.text(self.result_panel, 0, 100, "", 0.62, ui.C_WHITE)
    self.txt_res_loot = ui.text(self.result_panel, 0, 30, "", 0.68, ui.C_AQUA)

    self.btn_double, self.node_double, self.lbl_double = ui.button(
        self.druid, self.result_panel, 0, -60, 420, 76, i18n.t("double_loot"), ui.C_AMBER, "panel_rounded",
        function()
            local m = match_controller.get_state()
            if m.result and not m.result.doubled then
                poki.rewarded_break(function(ok)
                    if ok and m.result and not m.result.doubled then
                        m.result.doubled = true
                        progress.add_rewards(m.result.credits, 0)
                        m.result.credits = m.result.credits * 2
                    end
                end)
            end
        end, 0.56
    )

    self.btn_hangar, _, self.lbl_hangar = ui.button(
        self.druid, self.result_panel, -170, -170, 290, 82, i18n.t("hangar"), ui.C_ELEV, "panel_rounded",
        function()
            poki.try_commercial_break(function()
                msg.post("/controller#main", "open_hangar")
            end)
        end, 0.62
    )
    self.btn_next, _, self.lbl_next = ui.button(
        self.druid, self.result_panel, 170, -170, 290, 82, i18n.t("next_battle"), ui.C_GREEN, "panel_rounded",
        function()
            poki.try_commercial_break(function()
                msg.post("/controller#main", "start_battle")
            end)
        end, 0.62
    )
    gui.set_enabled(self.result_panel, false)
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.visible = true
    self.stick_active = false
    self.stick_origin = vmath.vector3(0, 0, 0)
    self.has_mouse_hover = false
    build_hud(self)
end

function final(self)
    if self.druid then self.druid:final() end
end

local function update_action_btn(node, lbl, base_lbl, cd, base_color)
    if cd > 0.05 then
        gui.set_color(node, ui.C_CARD)
        gui.set_text(lbl, string.format("%.1f", cd))
    else
        gui.set_color(node, base_color)
        gui.set_text(lbl, base_lbl)
    end
end

local tmp_color = vmath.vector4(1, 1, 1, 1)
local tmp_pos = vmath.vector3(0, 0, 0)
local tmp_scale = vmath.vector3(1, 1, 1)
local tmp_rot = vmath.vector3(0, 0, 0)

local function format_kf_actor(is_player, is_boss, part_kind, raw_name)
    if is_player then return i18n.t("you") end
    if part_kind then return i18n.t("part_" .. part_kind) end
    if is_boss then return i18n.t("dreadnought") end
    return (raw_name and raw_name ~= "") and raw_name or "---"
end

local function push_ship_marker(self, p, entity, team_color, sm_idx)
    if sm_idx > 7 then return sm_idx end
    if p then
        local dx = entity.pos.x - p.pos.x
        local dy = entity.pos.y - p.pos.y
        local dz = entity.pos.z - p.pos.z
        if dx * dx + dy * dy + dz * dz > 250 * 250 then return sm_idx end
    end
    local sx, sy, in_front = camera_rig.world_to_screen(entity.pos.x, entity.pos.y, entity.pos.z)
    if not in_front or sx < 60 or sx > 1860 or sy < 60 or sy > 965 then return sm_idx end
    local sm = self.ship_markers[sm_idx]
    gui.set_enabled(sm.box, true)
    tmp_pos.x, tmp_pos.y, tmp_pos.z = sx, math.min(980, sy + 28), 0
    gui.set_position(sm.box, tmp_pos)
    gui.set_color(sm.pip, team_color)
    gui.set_color(sm.hp, team_color)
    local sh_pct = (entity.max_shield and entity.max_shield > 0) and (entity.shield / entity.max_shield) or 0
    local hp_pct = (entity.max_hull and entity.max_hull > 0) and (entity.hull / entity.max_hull) or 0
    if sh_pct > 0.005 then
        gui.set_enabled(sm.sh, true)
        tmp_scale.x, tmp_scale.y, tmp_scale.z = sh_pct, 1, 1
        gui.set_scale(sm.sh, tmp_scale)
    else
        gui.set_enabled(sm.sh, false)
    end
    tmp_scale.x, tmp_scale.y, tmp_scale.z = math.max(0.001, hp_pct), 1, 1
    gui.set_scale(sm.hp, tmp_scale)
    return sm_idx + 1
end

local function show_offscreen_marker(self, pos, color, arrow_idx)
    if arrow_idx > 6 then return arrow_idx end
    local sx, sy, in_front = camera_rig.world_to_screen(pos.x, pos.y, pos.z)
    if in_front and sx > 80 and sx < 1840 and sy > 80 and sy < 1000 then return arrow_idx end
    local dx, dy = sx - 960, sy - 540
    local len = math.sqrt(dx * dx + dy * dy)
    if len < 0.001 then dx, dy, len = 0, 1, 1 end
    local nx, ny = dx / len, dy / len
    local px = 960 + nx * 780
    local py = 540 + ny * 430
    local arr = self.arrows[arrow_idx]
    gui.set_enabled(arr, true)
    tmp_pos.x, tmp_pos.y, tmp_pos.z = px, py, 0
    gui.set_position(arr, tmp_pos)
    gui.set_color(arr, color)
    local ang = math.atan2(ny, nx) - math.pi * 0.5
    tmp_rot.z = math.deg(ang)
    gui.set_rotation(arr, tmp_rot)
    return arrow_idx + 1
end

function update(self, dt)
    if self.druid then self.druid:update(dt) end
    if not self.visible then return end

    local m = match_controller.get_state()
    if not m.active and not m.finished then return end

    gui.set_enabled(self.node_pause, m.active and not m.finished)
    if m.paused then
        gui.set_enabled(self.steer_cursor, false)
        return
    end

    -- Simulation runs in main/main.script; HUD reads state cleanly

    -- Update desktop cursor steering dot
    local show_steer = m.active and self.has_mouse_hover and (math.abs(input_state.steer_x) > 0.001 or math.abs(input_state.steer_y) > 0.001)
    gui.set_enabled(self.steer_cursor, show_steer)
    if show_steer then
        gui.set_position(self.steer_cursor, vmath.vector3(960 + input_state.steer_x * 220, 540 + input_state.steer_y * 170, 0))
    end

    -- Refresh Top Bar
    local mode_key = (m.mode == "boss" and "mode_boss") or (m.mode == "domination" and "mode_dom") or "mode_tdm"
    gui.set_text(self.txt_mode, i18n.t(mode_key))
    local secs = math.max(0, math.ceil(m.timer))
    gui.set_text(self.txt_timer, string.format("%02d:%02d", math.floor(secs / 60), secs % 60))
    if m.mode == "domination" then
        gui.set_text(self.txt_score_t1, string.format("%d%%", math.floor(m.score_t1)))
        gui.set_text(self.txt_score_t2, string.format("%d%%", math.floor(m.score_t2)))
    elseif m.mode == "boss" then
        gui.set_text(self.txt_score_t1, i18n.t("kills") .. ": " .. m.player_kills)
        gui.set_text(self.txt_score_t2, "P" .. m.boss_phase .. "/3")
    else
        gui.set_text(self.txt_score_t1, tostring(m.score_t1))
        gui.set_text(self.txt_score_t2, tostring(m.score_t2))
    end

    -- Boss Bar
    gui.set_enabled(self.boss_bar_bg, m.mode == "boss")
    if m.mode == "boss" then
        local total_hp, cur_hp = 0, 0
        for _, bp in ipairs(m.boss_parts) do
            total_hp = total_hp + bp.max_hull
            if bp.alive then cur_hp = cur_hp + bp.hull end
        end
        local pct = total_hp > 0 and (cur_hp / total_hp) or 0
        gui.set_scale(self.boss_bar_fill, vmath.vector3(math.max(0.001, pct), 1, 1))
        local pk = (m.boss_phase == 1 and "boss_gen") or (m.boss_phase == 2 and "boss_turret") or "boss_reactor"
        gui.set_text(self.txt_boss_phase, i18n.t(pk))
    end

    -- Hint Banner
    gui.set_enabled(self.hint_bg, m.hint_timer > 0 and m.active)
    if m.hint_timer > 0 then
        gui.set_text(self.txt_hint, i18n.t(m.mode == "boss" and "hint_dreadnought" or "hint_first_15"))
    end

    -- Player Status & Buttons
    local p = m.player
    local missile_warn = m.active and not m.finished and p and p.alive and (m.boss_telegraph_player or combat_manager.has_incoming_missile(p))
    gui.set_enabled(self.missile_warn_bg, missile_warn)
    if missile_warn then
        local flash = 0.5 + 0.5 * math.sin(m.time_elapsed * 16.0)
        gui.set_text(self.txt_missile_warn, i18n.t("missile_warning"))
        tmp_color.x, tmp_color.y, tmp_color.z, tmp_color.w = 0.45 + flash * 0.45, 0.06, 0.08, 0.86
        gui.set_color(self.missile_warn_bg, tmp_color)
        tmp_color.x, tmp_color.y, tmp_color.z, tmp_color.w = 1.0, 0.72 + flash * 0.28, 0.22 + flash * 0.35, 1.0
        gui.set_color(self.txt_missile_warn, tmp_color)
    end

    if p then
        local sh_pct = p.max_shield > 0 and (p.shield / p.max_shield) or 0
        local hp_pct = p.max_hull > 0 and (p.hull / p.max_hull) or 0
        gui.set_scale(self.sh_fill, vmath.vector3(math.max(0.001, sh_pct), 1, 1))
        gui.set_scale(self.hp_fill, vmath.vector3(math.max(0.001, hp_pct), 1, 1))
        gui.set_text(self.txt_player_meta, string.format("T%d • %s: %d", p.tier, i18n.t("kills"), m.player_kills))

        local dash_color = ui.C_AQUA
        if missile_warn and p.dash_cd <= 0.05 then
            local pulse = 0.5 + 0.5 * math.sin(m.time_elapsed * 16.0)
            dash_color = (pulse > 0.5) and ui.C_GOLD or ui.C_CORAL
        end
        update_action_btn(self.node_dash, self.lbl_dash, i18n.t("dash"), p.dash_cd, dash_color)
        update_action_btn(self.node_mod1, self.lbl_mod1, i18n.t("mod_" .. p.mod1), p.mod1_cd, ui.C_ELEV)
        update_action_btn(self.node_mod2, self.lbl_mod2, i18n.t("mod_" .. p.mod2), p.mod2_cd, ui.C_ELEV)

        gui.set_enabled(self.respawn_box, not p.alive and m.active)
        if not p.alive then
            gui.set_text(self.txt_respawn, string.format("%s %.1fs", i18n.t("respawn_in"), math.max(0, p.respawn_timer)))
        end

        -- Soft Lock-On Target Marker + Lead Pip
        local lt = p.locked_target
        if m.active and not m.finished and p.alive and lt and lt.alive then
            local sx, sy, in_front = camera_rig.world_to_screen(lt.pos.x, lt.pos.y, lt.pos.z)
            gui.set_enabled(self.lock_ring, in_front)
            if in_front then
                gui.set_position(self.lock_ring, vmath.vector3(sx, sy, 0))
                local t_sh = (lt.max_shield and lt.max_shield > 0) and (lt.shield / lt.max_shield) or 0
                local t_hp = (lt.max_hull and lt.max_hull > 0) and (lt.hull / lt.max_hull) or 0
                gui.set_scale(self.lock_shield_fill, vmath.vector3(math.max(0.001, t_sh), 1, 1))
                gui.set_scale(self.lock_hull_fill, vmath.vector3(math.max(0.001, t_hp), 1, 1))
                local label = lt.is_boss_part and i18n.t("locked") or ((lt.flag ~= "" and lt.flag .. " " or "") .. lt.name)
                gui.set_text(self.lock_name, label)
            end
            local lp = lt.pos
            if lt.vel then
                local dist = vmath.length(lt.pos - p.pos)
                local t = math.min(1.5, dist / math.max(1, p.proj_speed))
                lp = lt.pos + lt.vel * t
            end
            local lx, ly, l_front = camera_rig.world_to_screen(lp.x, lp.y, lp.z)
            gui.set_enabled(self.lead_pip, l_front)
            if l_front then gui.set_position(self.lead_pip, vmath.vector3(lx, ly, 0)) end
            gui.set_color(self.reticle, ui.C_CORAL)
        else
            gui.set_enabled(self.lock_ring, false)
            gui.set_enabled(self.lead_pip, false)
            gui.set_color(self.reticle, vmath.vector4(0.15, 0.78, 0.85, 0.55))
        end
    end

    -- Hit Marker on Reticle
    if m.active and not m.finished and m.hit_marker_timer > 0 then
        local max_t = m.hit_marker_kill and 0.28 or 0.16
        local alpha = math.min(1.0, m.hit_marker_timer / max_t)
        local base_c = m.hit_marker_kill and ui.C_GOLD or ui.C_WHITE
        tmp_color.x, tmp_color.y, tmp_color.z, tmp_color.w = base_c.x, base_c.y, base_c.z, alpha
        local sc = (m.hit_marker_kill and 1.25 or 1.0) + 0.35 * alpha
        tmp_scale.x, tmp_scale.y, tmp_scale.z = sc, sc, 1
        gui.set_enabled(self.hit_marker, true)
        gui.set_color(self.hit_marker, tmp_color)
        gui.set_scale(self.hit_marker, tmp_scale)
    else
        gui.set_enabled(self.hit_marker, false)
    end

    -- Floating +1 KILL Banner
    if m.active and not m.finished and m.kill_banner_timer > 0 then
        local t_norm = 1.0 - (m.kill_banner_timer / 1.4)
        local alpha = math.min(1.0, m.kill_banner_timer / 0.35)
        tmp_color.x, tmp_color.y, tmp_color.z, tmp_color.w = ui.C_GOLD.x, ui.C_GOLD.y, ui.C_GOLD.z, alpha
        tmp_pos.x, tmp_pos.y, tmp_pos.z = 960, 645 + t_norm * 40, 0
        local sc = 0.72 + math.max(0, 1.0 - t_norm * 4.0) * 0.18
        tmp_scale.x, tmp_scale.y, tmp_scale.z = sc, sc, 1
        gui.set_enabled(self.kill_popup, true)
        gui.set_text(self.kill_popup, i18n.t("kill_plus"))
        gui.set_position(self.kill_popup, tmp_pos)
        gui.set_color(self.kill_popup, tmp_color)
        gui.set_scale(self.kill_popup, tmp_scale)
    else
        gui.set_enabled(self.kill_popup, false)
    end

    -- Compact 2D Ship Markers (HP/Shield + Team Color) for visible non-locked ships & targetable boss parts
    local sm_idx = 1
    local locked_tgt = (p and p.alive) and p.locked_target or nil
    if m.active and not m.finished then
        for i = 1, #m.ships do
            local s = m.ships[i]
            if not s.is_player and s.alive and s ~= locked_tgt then
                sm_idx = push_ship_marker(self, p, s, (s.team == 1) and ui.C_AQUA or ui.C_CORAL, sm_idx)
            end
        end
        if m.mode == "boss" then
            for i = 1, #m.boss_parts do
                local bp = m.boss_parts[i]
                if bp.alive and bp.targetable and bp ~= locked_tgt then
                    sm_idx = push_ship_marker(self, p, bp, ui.C_AMBER, sm_idx)
                end
            end
        end
    end
    for i = sm_idx, 7 do
        gui.set_enabled(self.ship_markers[i].box, false)
    end

    -- Kill Feed (Top-Right)
    for i = 1, 4 do
        local row_ui = self.kill_feed_rows[i]
        local kf = m.kill_feed and m.kill_feed[i]
        if m.active and not m.finished and kf and kf.active then
            gui.set_enabled(row_ui.row, true)
            local alpha = math.min(1.0, kf.timer / 0.7)
            tmp_color.x, tmp_color.y, tmp_color.z, tmp_color.w = ui.C_BG.x, ui.C_BG.y, ui.C_BG.z, ui.C_BG.w * alpha
            gui.set_color(row_ui.row, tmp_color)

            local kc = kf.killer_is_player and ui.C_GOLD or ((kf.killer_team == 1) and ui.C_AQUA or ui.C_CORAL)
            tmp_color.x, tmp_color.y, tmp_color.z, tmp_color.w = kc.x, kc.y, kc.z, alpha
            gui.set_color(row_ui.killer, tmp_color)
            gui.set_text(row_ui.killer, format_kf_actor(kf.killer_is_player, kf.killer_is_boss, nil, kf.killer_name))

            tmp_color.x, tmp_color.y, tmp_color.z, tmp_color.w = ui.C_DIM.x, ui.C_DIM.y, ui.C_DIM.z, alpha
            gui.set_color(row_ui.arrow, tmp_color)

            local vc = kf.victim_is_player and ui.C_GOLD or ((kf.victim_team == 1) and ui.C_AQUA or ui.C_CORAL)
            tmp_color.x, tmp_color.y, tmp_color.z, tmp_color.w = vc.x, vc.y, vc.z, alpha
            gui.set_color(row_ui.victim, tmp_color)
            gui.set_text(row_ui.victim, format_kf_actor(kf.victim_is_player, false, kf.victim_part_kind, kf.victim_name))
        else
            gui.set_enabled(row_ui.row, false)
        end
    end

    -- Off-Screen Enemy / Boss Markers
    local arrow_idx = 1
    if m.active and not m.finished then
        if m.mode == "boss" then
            for _, bp in ipairs(m.boss_parts) do
                if bp.alive and bp.targetable then
                    arrow_idx = show_offscreen_marker(self, bp.pos, ui.C_AMBER, arrow_idx)
                end
            end
        else
            for i = 1, #m.ships do
                local s = m.ships[i]
                if s.alive and s.team == 2 then
                    arrow_idx = show_offscreen_marker(self, s.pos, ui.C_CORAL, arrow_idx)
                end
            end
        end
    end
    for i = arrow_idx, 6 do gui.set_enabled(self.arrows[i], false) end

    -- Beacon Floating Icons (Domination)
    for i = 1, 3 do
        local bn = self.beacon_nodes[i]
        local b = m.beacons[i]
        if m.active and not m.finished and m.mode == "domination" and b then
            local sx, sy, in_front = camera_rig.world_to_screen(b.pos.x, b.pos.y, b.pos.z)
            gui.set_enabled(bn.box, in_front)
            if in_front then
                tmp_pos.x, tmp_pos.y, tmp_pos.z = sx, sy, 0
                gui.set_position(bn.box, tmp_pos)
                local c = (b.owner == 1 and ui.C_AQUA) or (b.owner == 2 and ui.C_CORAL) or ui.C_AMBER
                gui.set_color(bn.box, c)
            end
        else
            gui.set_enabled(bn.box, false)
        end
    end

    -- Pickup Sphere Floating Icons & Toast
    for i = 1, 3 do
        local pn = self.pickup_nodes[i]
        local pk = m.pickups and m.pickups[i]
        if m.active and not m.finished and pk and pk.active then
            local sx, sy, in_front = camera_rig.world_to_screen(pk.pos.x, pk.pos.y, pk.pos.z)
            local on_scr = in_front and sx > 60 and sx < 1860 and sy > 60 and sy < 1020
            gui.set_enabled(pn.box, on_scr)
            if on_scr then
                tmp_pos.x, tmp_pos.y, tmp_pos.z = sx, sy, 0
                gui.set_position(pn.box, tmp_pos)
                local is_rep = pk.kind == "repair"
                gui.set_color(pn.box, is_rep and ui.C_GREEN or ui.C_AQUA)
                gui.set_text(pn.txt, is_rep and "+" or "CD")
            end
        else
            gui.set_enabled(pn.box, false)
        end
    end
    if m.active and not m.finished and m.pickup_toast and m.pickup_toast.timer > 0 then
        local pt = m.pickup_toast
        local alpha = math.min(1.0, pt.timer / 0.45)
        local c = (pt.kind == "repair") and ui.C_GREEN or ui.C_AQUA
        tmp_color.x, tmp_color.y, tmp_color.z, tmp_color.w = c.x, c.y, c.z, alpha
        gui.set_enabled(self.pickup_toast, true)
        gui.set_text(self.pickup_toast, i18n.t(pt.kind == "repair" and "pickup_repair" or "pickup_charge"))
        gui.set_color(self.pickup_toast, tmp_color)
    else
        gui.set_enabled(self.pickup_toast, false)
    end

    -- Post-Match Result Overlay
    gui.set_enabled(self.result_panel, m.finished)
    if m.finished and m.result then
        local r = m.result
        gui.set_text(self.txt_res_title, i18n.t(r.won and "victory" or "defeat"))
        gui.set_color(self.txt_res_title, r.won and ui.C_GOLD or ui.C_CORAL)
        gui.set_text(self.txt_res_stats, string.format("%s: %d", i18n.t("kills"), r.kills))
        gui.set_text(self.txt_res_loot, string.format("+%d %s   +%d %s", r.credits, i18n.t("credits"), r.parts, i18n.t("parts")))
        gui.set_enabled(self.node_double, not r.doubled)
        gui.set_text(self.lbl_double, i18n.t("double_loot"))
        gui.set_text(self.lbl_hangar, i18n.t("hangar"))
        gui.set_text(self.lbl_next, i18n.t("next_battle"))
    end
end

function on_input(self, action_id, action)
    if not self.visible then return false end
    if self.druid and self.druid:on_input(action_id, action) then
        return true
    end

    local m = match_controller.get_state()
    if action_id == PAUSE and action.pressed and m.active and not m.finished then
        set_pause_open(self, not m.paused)
        return true
    end
    if not m.active or m.paused then return false end

    if action_id == DASH and action.pressed then
        poki.gameplay_start()
        input_state.dash_pressed = true
        return true
    elseif action_id == MOD1 and action.pressed then
        poki.gameplay_start()
        input_state.mod1_pressed = true
        return true
    elseif action_id == MOD2 and action.pressed then
        poki.gameplay_start()
        input_state.mod2_pressed = true
        return true
    elseif action_id == TOUCH_MULTI then
        self.has_mouse_hover = false
        return false
    elseif action_id == TOUCH then
        poki.gameplay_start()
        local vx = action.x or 960
        local vy = action.y or 540
        if action.pressed then
            -- Use floating virtual stick on left half when on touch device (no recent mouse hover)
            if vx < 860 and not self.has_mouse_hover then
                self.stick_active = true
                self.stick_origin = vmath.vector3(vx, vy, 0)
                gui.set_enabled(self.stick_base, true)
                gui.set_position(self.stick_base, self.stick_origin)
                gui.set_position(self.stick_knob, vmath.vector3(0, 0, 0))
            else
                input_state.fire_held = true
            end
        elseif action.released then
            input_state.fire_held = false
            if self.stick_active then
                self.stick_active = false
                gui.set_enabled(self.stick_base, false)
                input_state.steer_x = 0
                input_state.steer_y = 0
            end
        elseif self.stick_active then
            local dx = vx - self.stick_origin.x
            local dy = vy - self.stick_origin.y
            local max_r = 85.0
            local d = math.sqrt(dx * dx + dy * dy)
            if d > max_r then
                dx = dx * (max_r / d)
                dy = dy * (max_r / d)
            end
            gui.set_position(self.stick_knob, vmath.vector3(dx, dy, 0))
            input_state.steer_x = dx / max_r
            input_state.steer_y = dy / max_r
        end
        return true
    elseif action_id == nil and not self.stick_active then
        -- Mouse move steering on desktop
        local win_w, win_h = window.get_size()
        if win_w > 0 and win_h > 0 and action.screen_x then
            if math.abs(action.dx or 0) + math.abs(action.dy or 0) > 0 then
                self.has_mouse_hover = true
            end
            local nx = ((action.screen_x / win_w) - 0.5) * 2.0 * 1.15
            local ny = ((action.screen_y / win_h) - 0.5) * 2.0 * 1.15
            local sx, sy = apply_radial_deadzone(nx, ny, 0.06)
            input_state.steer_x = sx
            input_state.steer_y = sy
            if math.abs(sx) > 0.01 or math.abs(sy) > 0.01 then
                poki.gameplay_start()
            end
        end
    end
    return false
end

function on_message(self, message_id, message)
    if message_id == hash("set_visible") then
        self.visible = message.visible and true or false
        gui.set_enabled(self.root, self.visible)
        reset_input()
        self.stick_active = false
        gui.set_enabled(self.hit_marker, false)
        gui.set_enabled(self.kill_popup, false)
        gui.set_enabled(self.missile_warn_bg, false)
        gui.set_enabled(self.pickup_toast, false)
        gui.set_enabled(self.result_panel, false)
        gui.set_enabled(self.respawn_box, false)
        gui.set_enabled(self.lock_ring, false)
        gui.set_enabled(self.lead_pip, false)
        for i = 1, 3 do gui.set_enabled(self.pickup_nodes[i].box, false) end
        for i = 1, 7 do gui.set_enabled(self.ship_markers[i].box, false) end
        for i = 1, 4 do gui.set_enabled(self.kill_feed_rows[i].row, false) end
        for i = 1, 6 do gui.set_enabled(self.arrows[i], false) end
        gui.set_enabled(self.stick_base, false)
        gui.set_enabled(self.steer_cursor, false)
        gui.set_enabled(self.pause_backdrop, false)
        if self.blocker_pause then self.blocker_pause:set_enabled(false) end
        if self.btn_dash then self.btn_dash:set_enabled(true) end
        if self.btn_mod1 then self.btn_mod1:set_enabled(true) end
        if self.btn_mod2 then self.btn_mod2:set_enabled(true) end
        if self.btn_pause then self.btn_pause:set_enabled(true) end
        if self.visible then
            gui.set_text(self.lbl_dash, i18n.t("dash"))
        end
    end
end
