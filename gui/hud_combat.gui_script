        local txt_v = ui.text(row, 14, 0, "", 0.34, ui.C_CORAL, gui.PIVOT_W)
        gui.set_enabled(row, false)
        self.kill_feed_rows[i] = { row = row, killer = txt_k, arrow = txt_a, victim = txt_v }
    end

    -- Top-Right Pause Button
    self.btn_pause, self.node_pause = ui.button(
        self.druid, self.root, 1850, 1026, 84, 64, "||", ui.C_BG, "panel_rounded",
        function()
            local m = match_controller.get_state()
            if m.active and not m.finished then
                set_pause_open(self, not m.paused)
            end
        end, 0.58
