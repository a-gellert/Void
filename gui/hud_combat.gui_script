    end
    self.wp_node = ui.box(self.root, 0, 0, 60, 60, ui.C_GOLD, "lock_ring")
    self.wp_dist = ui.text(self.wp_node, 0, -44, "", 0.32, ui.C_GOLD)
    gui.set_enabled(self.wp_node, false)
    self.arrows = {}
    for i = 1, N_ARROWS do
        self.arrows[i] = ui.box(self.root, 0, 0, 30, 30, ui.C_CORAL, "arrow_up")
        gui.set_enabled(self.arrows[i], false)
    end

    -- Centre: reticle, steering ring + cursor, lock, lead pip, hit marker
    self.reticle = ui.box(self.root, 960, 540, 200, 200, vmath.vector4(0.15, 0.78, 0.85, 0.55), "reticle")
    self.steer_cursor = ui.box(self.root, 960, 540, 18, 18, vmath.vector4(0.15, 0.78, 0.85, 0.8), "dot")
    self.hit_marker = ui.box(self.root, 960, 540, 56, 56, ui.C_WHITE, "hit_marker")
    gui.set_enabled(self.hit_marker, false)
    self.lock_ring = ui.box(self.root, 960, 540, 86, 86, ui.C_CORAL, "lock_ring")
