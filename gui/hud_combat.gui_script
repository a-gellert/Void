            local y = 150 - (r - 1) * 42
            local name = ui.text(self.board, x0 - 220, y, "", 0.36, ui.C_WHITE, gui.PIVOT_W)
            local kd = ui.text(self.board, x0 + 120, y, "", 0.36, ui.C_WHITE)
            self.board_rows[#self.board_rows + 1] = { team = team, name = name, kd = kd }
