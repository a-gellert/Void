    self.msl_cd = ui.text(self.status, 185, -44, "", 0.28, ui.C_DIM, gui.PIVOT_E)
    self.txt_status_hint = ui.text(self.status, 0, -72, "", 0.26, ui.C_DIM)

    -- Radar (bottom centre)
    self.radar = ui.box(self.root, 225, 338, 210, 210, vmath.vector4(0.25, 0.75, 0.85, 0.85), "radar")
    self.radar_me = ui.box(self.radar, 0, 0, 16, 16, ui.C_WHITE, "arrow_up")
    self.blips = {}
    for i = 1, N_BLIPS do
