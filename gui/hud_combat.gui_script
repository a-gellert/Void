-- Combat HUD + all battle input (mouse, keyboard, multi-touch, gamepad).
-- Reads match_controller state; writes modules/input_state.
local druid = require("druid.druid")
local _
local ui = require("gui.ui_helper")
local i18n = require("modules.i18n")
local match_controller = require("modules.match_controller")
local camera_rig = require("modules.camera_rig")
local input_state = require("modules.input_state")
local progress = require("modules.progress")
local campaign_db = require("data.campaign_db")
local progression_db = require("data.progression_db")
local modules_db = require("data.modules_db")
local math3d = require("modules.math3d")
local audio = require("modules.audio")
local poki = require("modules.poki")

local H = {
    TOUCH = hash("touch"), TOUCH_MULTI = hash("touch_multi"), PAUSE = hash("pause"),
    DASH = hash("dash"), MOD1 = hash("mod1"), MOD2 = hash("mod2"), MISSILE = hash("missile"),
    BOOST = hash("boost"), UP = hash("throttle_up"), BRAKE = hash("brake"),
    SL = hash("strafe_left"), SR = hash("strafe_right"), SCORE = hash("scoreboard"),
    GP_L = hash("gp_left"), GP_R = hash("gp_right"), GP_U = hash("gp_up"), GP_D = hash("gp_down"),
    GP_FIRE = hash("gp_fire"), GP_BOOST = hash("gp_boost"), GP_BRAKE = hash("gp_brake"),
    CONFIRM = hash("confirm"), BACK = hash("key_back"),
}

local N_MARKERS = 12
local N_ARROWS = 8
local N_BLIPS = 26
local RADAR_R = 100
local RADAR_RANGE = 260

local tmp_pos = vmath.vector3()
local tmp_scale = vmath.vector3(1, 1, 1)
local tmp_rot = vmath.vector3()
local tmp_col = vmath.vector4()

local function fmt(key, a, b)
    local s = i18n.t(key)
    local ok, out = pcall(string.format, s, a or 0, b or 0)
    return ok and out or s
end

local function device_key(key)
    if input_state.device == "touch" and i18n.has(key .. "_touch") then return key .. "_touch" end
    if input_state.device == "gamepad" and i18n.has(key .. "_pad") then return key .. "_pad" end
    return key
end

local function set_pos(node, x, y)
    tmp_pos.x, tmp_pos.y, tmp_pos.z = x, y, 0
    gui.set_position(node, tmp_pos)
end

local function set_scale(node, s)
    tmp_scale.x, tmp_scale.y, tmp_scale.z = s, s, 1
    gui.set_scale(node, tmp_scale)
end

-- ===================================================================== BUILD
local function make_action(self, id, x, y, size, color, label, keyhint)
    local node = ui.box(self.root, x, y, size, size, color, "btn_circle")
    gui.set_clipping_mode(node, gui.CLIPPING_MODE_STENCIL)
    local cd = ui.box(node, 0, -size * 0.5, size, size, vmath.vector4(0.02, 0.04, 0.08, 0.72))
    gui.set_pivot(cd, gui.PIVOT_S)
    local lbl = ui.text(node, 0, keyhint and 8 or 0, label, size > 130 and 0.46 or 0.36, ui.C_WHITE)
    local key = ui.text(node, 0, -size * 0.26, keyhint or "", 0.28, ui.C_DIM)
    local b = { id = id, node = node, cd = cd, lbl = lbl, key = key, size = size, color = color, base = label }
    self.actions[id] = b
    self.action_list[#self.action_list + 1] = b
    return b
end

local function build(self)
    if self.root then gui.delete_node(self.root) end
    if self.druid then self.druid:final() end
    self.druid = druid.new(self)
    self.root = ui.box(nil, 0, 0, 0, 0, vmath.vector4(0, 0, 0, 0))
    gui.set_enabled(self.root, self.visible)

    -- Hurt / low hull vignette
    self.vignette = ui.box(self.root, 960, 540, 1920, 1080, vmath.vector4(1, 0.1, 0.12, 0), "vignette")

    -- World markers (ships, structures) with mini bars
    self.markers = {}
    for i = 1, N_MARKERS do
        local box = ui.box(self.root, 0, 0, 74, 14, vmath.vector4(0.02, 0.04, 0.08, 0.7))
        local pip = ui.box(box, -45, 0, 9, 9, ui.C_AQUA)
        gui.set_rotation(pip, vmath.vector3(0, 0, 45))
        local sh = ui.box(box, -32, 3, 64, 3, ui.C_SHIELD)
        gui.set_pivot(sh, gui.PIVOT_W)
        local hp = ui.box(box, -32, -2, 64, 4, ui.C_AQUA)
        gui.set_pivot(hp, gui.PIVOT_W)
        local name = ui.text(box, 0, 16, "", 0.26, ui.C_WHITE)
        gui.set_enabled(box, false)
        self.markers[i] = { box = box, pip = pip, sh = sh, hp = hp, name = name }
    end
    self.dmg_nodes = {}
    for i = 1, 12 do
        local t = ui.text(self.root, 0, 0, "", 0.42, ui.C_WHITE)
        gui.set_enabled(t, false)
        self.dmg_nodes[i] = t
    end
    self.beacon_nodes = {}
    for i = 1, 3 do
        local bn = ui.box(self.root, 0, 0, 52, 52, ui.C_AMBER, "lock_ring")
        local bt = ui.text(bn, 0, 0, string.char(64 + i), 0.5, ui.C_WHITE)
        local bar_bg, bar = ui.bar(bn, 0, -36, 48, 5, ui.C_AQUA)
        gui.set_enabled(bn, false)
        self.beacon_nodes[i] = { box = bn, txt = bt, bar = bar, bar_bg = bar_bg }
    end
    self.pickup_nodes = {}
    for i = 1, 3 do
        local pn = ui.box(self.root, 0, 0, 30, 30, ui.C_GREEN, "lock_ring")
        local pt = ui.text(pn, 0, 0, "+", 0.4, ui.C_WHITE)
        gui.set_enabled(pn, false)
