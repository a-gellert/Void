    self.txt_speed = ui.text(self.status, 185, 64, "", 0.36, ui.C_WHITE, gui.PIVOT_E)
    ui.text(self.status, -185, 36, i18n.t("shield"), 0.28, ui.C_SHIELD, gui.PIVOT_W)
    self.sh_bg, self.sh_fill = ui.bar(self.status, 40, 36, 280, 14, ui.C_SHIELD)
    self.lbl_hull = ui.text(self.status, -185, 12, i18n.t("hull"), 0.28, ui.C_GREEN, gui.PIVOT_W)
    self.hp_bg, self.hp_fill = ui.bar(self.status, 40, 12, 280, 16, ui.C_GREEN)
    self.lbl_energy = ui.text(self.status, -185, -14, i18n.t("energy"), 0.28, ui.C_ENERGY, gui.PIVOT_W)
    self.en_bg, self.en_fill = ui.bar(self.status, 40, -14, 280, 10, ui.C_ENERGY)
    self.lbl_msl = ui.text(self.status, -185, -44, i18n.t("missiles"), 0.28, ui.C_AMBER, gui.PIVOT_W)
    self.msl_pips = {}
