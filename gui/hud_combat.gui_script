        self.druid, self.root, 1740, 150, 150, 150, i18n.t("dash"), ui.C_AQUA, "btn_circle",
        function() input_state.dash_pressed = true end, 0.48
    )
    self.btn_mod1, self.node_mod1, self.lbl_mod1 = ui.button(
        self.druid, self.root, 1630, 320, 118, 118, "M1", ui.C_ELEV, "btn_circle",
        function() input_state.mod1_pressed = true end, 0.40
    )
    self.btn_mod2, self.node_mod2, self.lbl_mod2 = ui.button(
        self.druid, self.root, 1800, 320, 118, 118, "M2", ui.C_ELEV, "btn_circle",
        function() input_state.mod2_pressed = true end, 0.40
    )

    -- Kill Feed (Top-Right below Pause button, up to 4 rows)
    self.kill_feed_rows = {}
    for i = 1, 4 do
        local row = ui.box(self.root, 1705, 950 - (i - 1) * 40, 380, 34, ui.C_BG, "panel_rounded")
        local txt_k = ui.text(row, -14, 0, "", 0.34, ui.C_AQUA, gui.PIVOT_E)
