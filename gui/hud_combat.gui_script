local druid = require("druid.druid")
local ui = require("gui.ui_helper")
local i18n = require("modules.i18n")
local match_controller = require("modules.match_controller")
local camera_rig = require("modules.camera_rig")
local combat_manager = require("modules.combat_manager")
local progress = require("modules.progress")
local audio = require("modules.audio")
local poki = require("modules.poki")

local TOUCH = hash("touch")
local TOUCH_MULTI = hash("touch_multi")
local PAUSE = hash("pause")
local DASH = hash("dash")
local MOD1 = hash("mod1")
local MOD2 = hash("mod2")

local input_state = match_controller.get_input_state()
local reset_input = match_controller.reset_input

local function apply_radial_deadzone(nx, ny, dz)
    local mag = math.sqrt(nx * nx + ny * ny)
    if mag <= dz then return 0, 0 end
    local scaled = math.min(1.0, (mag - dz) / (1.0 - dz)) / mag
    return nx * scaled, ny * scaled
end

local function refresh_hud_labels(self)
    local m = match_controller.get_state()
    local mode_key = (m.mode == "boss" and "mode_boss") or (m.mode == "domination" and "mode_dom") or "mode_tdm"
    gui.set_text(self.txt_mode, i18n.t(mode_key))
    gui.set_text(self.lbl_dash, i18n.t("dash"))
    if m.player then
        gui.set_text(self.txt_player_meta, string.format("T%d • %s: %d", m.player.tier, i18n.t("kills"), m.player_kills))
        if m.player.mod1_cd <= 0.05 then gui.set_text(self.lbl_mod1, i18n.t("mod_" .. m.player.mod1)) end
        if m.player.mod2_cd <= 0.05 then gui.set_text(self.lbl_mod2, i18n.t("mod_" .. m.player.mod2)) end
    end
    if m.hint_timer > 0 then
        gui.set_text(self.txt_hint, i18n.t(m.mode == "boss" and "hint_dreadnought" or "hint_first_15"))
    end
end

local function refresh_pause_labels(self)
    gui.set_text(self.txt_pause_title, i18n.t("pause"))
    gui.set_text(self.lbl_resume, i18n.t("resume"))
    gui.set_text(self.lbl_pause_sound, i18n.t("sound") .. ": " .. i18n.t(audio.is_muted() and "off" or "on"))
    gui.set_text(self.lbl_pause_lang, i18n.t("language") .. ": " .. string.upper(i18n.get_language()))
    gui.set_text(self.lbl_pause_hangar, i18n.t("quit_hangar"))
    refresh_hud_labels(self)
end

local function set_pause_open(self, paused)
    local m = match_controller.get_state()
    if not m.active or m.finished then paused = false end
    reset_input()
    self.stick_active = false
    gui.set_enabled(self.stick_base, false)
    gui.set_enabled(self.steer_cursor, false)
    if paused then
        gui.set_enabled(self.respawn_box, false)
        gui.set_enabled(self.missile_warn_bg, false)
    end
    match_controller.set_paused(paused)
    gui.set_enabled(self.pause_backdrop, paused)
    if self.blocker_pause then self.blocker_pause:set_enabled(paused) end
    if self.btn_dash then self.btn_dash:set_enabled(not paused) end
    if self.btn_mod1 then self.btn_mod1:set_enabled(not paused) end
    if self.btn_mod2 then self.btn_mod2:set_enabled(not paused) end
    if self.btn_pause then self.btn_pause:set_enabled(not paused) end
    if paused then
        refresh_pause_labels(self)
    end
end

local function build_hud(self)
    if self.root then gui.delete_node(self.root) end
    if self.druid then self.druid:final() end
    self.druid = druid.new(self)

    self.root = ui.box(nil, 0, 0, 0, 0, vmath.vector4(0, 0, 0, 0))
    gui.set_enabled(self.root, self.visible)

    -- Compact 2D Ship Markers (rendered behind HUD panels & reticle)
    self.ship_markers = {}
    for i = 1, 7 do
        local box = ui.box(self.root, 0, 0, 74, 16, ui.C_BG, "white")
        local pip = ui.box(box, -45, 0, 9, 9, ui.C_AQUA, "white")
        gui.set_rotation(pip, vmath.vector3(0, 0, 45))
        local sh = ui.box(box, -32, 3, 64, 4, vmath.vector4(0.60, 0.92, 1.0, 1.0))
        gui.set_pivot(sh, gui.PIVOT_W)
        local hp = ui.box(box, -32, -3, 64, 5, ui.C_AQUA)
        gui.set_pivot(hp, gui.PIVOT_W)
        gui.set_enabled(box, false)
        self.ship_markers[i] = { box = box, pip = pip, sh = sh, hp = hp }
    end

    -- Top Scoreboard
    self.top_bar = ui.box(self.root, 960, 1026, 660, 72, ui.C_BG, "panel_rounded")
    self.txt_mode = ui.text(self.top_bar, 0, 20, "", 0.42, ui.C_AQUA)
    self.txt_score_t1 = ui.text(self.top_bar, -180, -10, "0", 0.78, ui.C_AQUA)
    self.txt_timer = ui.text(self.top_bar, 0, -10, "01:30", 0.72, ui.C_WHITE)
    self.txt_score_t2 = ui.text(self.top_bar, 180, -10, "0", 0.78, ui.C_CORAL)

    -- Boss HP Bar (visible only in Boss Raid)
    self.boss_bar_bg = ui.box(self.root, 960, 962, 540, 24, ui.C_BG, "panel_rounded")
    self.boss_bar_fill = ui.box(self.boss_bar_bg, -264, 0, 528, 14, ui.C_CORAL, "white")
    gui.set_pivot(self.boss_bar_fill, gui.PIVOT_W)
    self.txt_boss_phase = ui.text(self.boss_bar_bg, 0, -24, "", 0.42, ui.C_AMBER)

    -- Hint Banner (First 15s / Boss instructions) & Missile Salvo Warning
    self.hint_bg = ui.box(self.root, 960, 880, 920, 48, ui.C_BG, "panel_rounded")
    self.txt_hint = ui.text(self.hint_bg, 0, 0, "", 0.48, ui.C_GOLD)
    self.missile_warn_bg = ui.box(self.root, 960, 816, 720, 46, vmath.vector4(0.32, 0.06, 0.08, 0.88), "panel_rounded")
    self.txt_missile_warn = ui.text(self.missile_warn_bg, 0, 0, "", 0.46, ui.C_GOLD)
    gui.set_enabled(self.missile_warn_bg, false)

    -- Center Soft Lock-On Reticle, Hit Marker, +1 KILL Popup & Steering Cursor Pip
    self.reticle = ui.box(self.root, 960, 540, 220, 220, vmath.vector4(0.15, 0.78, 0.85, 0.55), "reticle")
    self.hit_marker = ui.box(self.root, 960, 540, 56, 56, ui.C_WHITE, "hit_marker")
    gui.set_enabled(self.hit_marker, false)
    self.kill_popup = ui.text(self.root, 960, 660, "", 0.72, ui.C_GOLD)
    gui.set_enabled(self.kill_popup, false)
    self.steer_cursor = ui.box(self.root, 960, 540, 20, 20, vmath.vector4(0.15, 0.78, 0.85, 0.75), "stick_knob")
    gui.set_enabled(self.steer_cursor, false)
    self.lock_ring = ui.box(self.root, 960, 540, 86, 86, ui.C_CORAL, "lock_ring")
