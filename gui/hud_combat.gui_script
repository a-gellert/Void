    -- Respawn Banner (under Pause Overlay in z-order)
    self.respawn_box = ui.box(self.root, 960, 540, 420, 90, ui.C_BG, "panel_rounded")
    self.txt_respawn = ui.text(self.respawn_box, 0, 0, "", 0.72, ui.C_CORAL)
