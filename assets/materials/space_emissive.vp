#version 140

in highp vec4 position;
in mediump vec2 texcoord0;

out mediump vec2 var_texcoord0;

uniform vs_uniforms
{
    mediump mat4 mtx_worldview;
    mediump mat4 mtx_proj;
    mediump vec4 stretch;
};

void main()
{
    var_texcoord0 = texcoord0;
    vec3 p = position.xyz * stretch.xyz;
    p.z += stretch.w;
    gl_Position = mtx_proj * (mtx_worldview * vec4(p, 1.0));
}
